<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="quest"/>
        <attribute name="authors" value="Lenovo"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-26 08:06:33 PM"/>
        <attribute name="created" value="TGVub3ZvO0RFU0tUT1AtNEFISFJNTDsyMDI2LTEwLTI1OzA4OjAyOjE2IFBNOzI5ODU="/>
        <attribute name="edited" value="TGVub3ZvO0RFU0tUT1AtNEFISFJNTDsyMDI2LTEwLTI2OzA4OjA2OjMzIFBNOzI7MzA5OA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="guests, buuzper, fam1, fam2, fam3, day, dayguests, daybuuz, t" type="Integer" array="False" size=""/>
            <declare name="meat, flour, hours, factor, daymeat, dayflour" type="Real" array="False" size=""/>
            <do expression="guests&lt;=0">
                <output expression="&quot;&#1047;&#1086;&#1095;&#1076;&#1099;&#1085; &#1090;&#1086;&#1086;?&quot;" newline="True"/>
                <input variable="guests"/>
            </do>
            <do expression="buuzper&lt;=0||buuzper&gt;40">
                <output expression="&quot;&#1053;&#1101;&#1075; &#1093;&#1199;&#1085;&#1076; &#1085;&#1086;&#1075;&#1076;&#1086;&#1093; &#1073;&#1091;&#1091;&#1079;&#1085;&#1099; &#1090;&#1086;&#1086;?&quot;" newline="True"/>
                <input variable="buuzper"/>
            </do>
            <output expression="&quot;2 &#1076;&#1086;&#1093; &#1072;&#1081;&#1083;&#1099;&#1085; &#1073;&#1091;&#1091;&#1079;&#1085;&#1099; &#1090;&#1086;&#1086;:&quot;" newline="True"/>
            <input variable="fam2"/>
            <output expression="&quot;3 &#1076;&#1072;&#1093; &#1072;&#1081;&#1083;&#1099;&#1085; &#1073;&#1091;&#1091;&#1079;&#1085;&#1099; &#1090;&#1086;&#1086;:&quot;" newline="True"/>
            <input variable="fam3"/>
            <assign variable="fam1" expression="guests*buuzper"/>
            <assign variable="meat" expression="(fam1*20.0)/1000.0"/>
            <assign variable="flour" expression="(fam1*15)/1000.0"/>
            <assign variable="hours" expression="preparationtime(fam1)"/>
            <if expression="fam1&lt;200">
                <then>
                    <output expression="&quot;&#1041;&#1072;&#1075;&#1072;&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="fam1&lt;=600">
                        <then>
                            <output expression="&quot;&#1044;&#1091;&#1085;&#1076;&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="fam1&gt;600">
                                <then>
                                    <output expression="&quot;&#1048;&#1093;&quot;" newline="True"/>
                                </then>
                                <else/>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <output expression="&quot;&#1053;&#1080;&#1081;&#1090; &#1093;&#1080;&#1081;&#1093; &#1073;&#1091;&#1091;&#1079;: &quot;&amp;fam1&amp;&quot;&#1096;&#1080;&#1088;&#1093;&#1101;&#1075;&quot;" newline="True"/>
            <output expression="&quot;&#1064;&#1072;&#1072;&#1088;&#1076;&#1083;&#1072;&#1075;&#1072;&#1090;&#1072;&#1081; &#1084;&#1072;&#1093;:&quot;&amp;meat&amp;&quot;&#1082;&#1075;&quot;" newline="True"/>
            <output expression="&quot;&#1064;&#1072;&#1072;&#1072;&#1088;&#1076;&#1083;&#1072;&#1075;&#1072;&#1090;&#1072;&#1081; &#1075;&#1091;&#1088;&#1080;&#1083;:&quot;&amp;flour&amp;&quot;&#1082;&#1075;&quot;" newline="True"/>
            <output expression="&quot;&#1041;&#1101;&#1083;&#1090;&#1075;&#1101;&#1093; &#1085;&#1080;&#1081;&#1090; &#1093;&#1091;&#1075;&#1072;&#1094;&#1072;&#1072;: &quot;&amp;hours&amp;&quot;&#1094;&#1072;&#1075;&quot;" newline="True"/>
            <for variable="day" start="1" end="5" direction="inc" step="1">
                <if expression="day==1">
                    <then>
                        <assign variable="factor" expression="1.0"/>
                    </then>
                    <else>
                        <if expression="day==2">
                            <then>
                                <assign variable="factor" expression="0.8"/>
                            </then>
                            <else>
                                <if expression="day==3">
                                    <then>
                                        <assign variable="factor" expression="0.6"/>
                                    </then>
                                    <else>
                                        <if expression="day==4">
                                            <then>
                                                <assign variable="factor" expression="0.4"/>
                                            </then>
                                            <else>
                                                <assign variable="factor" expression="0.2"/>
                                            </else>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
                <assign variable="dayguests" expression="guests*factor"/>
                <assign variable="daybuuz" expression="dayguests*buuzper"/>
                <output expression="&quot;&#1064;&#1080;&#1085;&#1080;&#1081;&#1085; &quot; &amp; day &amp; &quot;-&#1085;&#1076;: &#1047;&#1086;&#1095;&#1080;&#1076;: &quot;&amp;dayguests&amp;&quot;, &#1041;&#1091;&#1091;&#1079;: &quot;&amp;daybuuz&amp;&quot; &quot;" newline="True"/>
            </for>
            <if expression="fam1&lt;fam2">
                <then>
                    <assign variable="t" expression="fam1"/>
                    <assign variable="fam1" expression="fam2"/>
                    <assign variable="fam2" expression="t"/>
                </then>
                <else>
                    <if expression="fam1&lt;fam3">
                        <then>
                            <assign variable="t" expression="fam1"/>
                            <assign variable="fam1" expression="fam2"/>
                            <assign variable="fam2" expression="t"/>
                        </then>
                        <else>
                            <if expression="fam2&lt;fam3">
                                <then>
                                    <assign variable="t" expression="fam2"/>
                                    <assign variable="fam2" expression="fam3"/>
                                    <assign variable="fam3" expression="t"/>
                                </then>
                                <else/>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <output expression="&quot;3 &#1072;&#1081;&#1083;&#1099;&#1085; &#1073;&#1091;&#1091;&#1079;:&quot;" newline="True"/>
            <output expression="&quot;1. &quot;&amp;fam1&amp;&quot;&quot;" newline="True"/>
            <output expression="&quot;2. &quot;&amp;fam2&amp;&quot;&quot;" newline="True"/>
            <output expression="&quot;3. &quot;&amp;fam3&amp;&quot;&quot;" newline="True"/>
        </body>
    </function>
    <function name="preparationtime" type="Real" variable="hours">
        <parameters>
            <parameter name="buuz" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="hours" type="Real" array="False" size=""/>
            <assign variable="hours" expression="(buuz*0.5)/60.0"/>
        </body>
    </function>
</flowgorithm>
